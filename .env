EMAIL_APP_PASSWORD=paste_your_gmail_app_password_here

# Secret code required to create an ADMIN account (admin web -> Register).
# If this is left out, nobody can register as admin (existing admins still log in).
ADMIN_SIGNUP_CODE=choose_a_long_secret_code_here

# Optional: password for the demo accounts created by `node scripts/seedDemoData.js`
# (default is Demo@1234)
DEMO_PASSWORD=Demo@1234

# ---- Update 5 (all optional) ----
# Shown in the privacy notice: an email or phone where people can ask about their data.
PRIVACY_CONTACT=privacy@your-domain.lk
# Old app versions below APP_MIN_VERSION are asked to update.
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.1.0
APP_DOWNLOAD_URL=
APP_UPDATE_MESSAGE=
# SMS alerts (any gateway that accepts POST JSON {to, message, sender} with a Bearer token). Empty = SMS off.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=AgriLink
SMS_MONTHLY_CAP=15
# Push notifications: paste the Firebase service-account JSON (one line) and run `npm i firebase-admin`. Empty = push off.
FIREBASE_SERVICE_ACCOUNT=
# Signs the 48-hour printable report links (defaults to JWT_SECRET).
REPORT_LINK_SECRET=
# Abuse limits (per server copy)
RATE_LIMIT_GENERAL=1500
RATE_LIMIT_FORGOT=10
RATE_LIMIT_ADTRACK=60
LOGIN_MAX_FAILS=8
